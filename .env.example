# Postgres connection string (Neon, Supabase, Railway, or local Postgres all work)
DATABASE_URL="postgresql://user:password@localhost:5432/fpl_clone"

# NextAuth (generate a secret with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Resend (email verification) - get a free API key at resend.com
RESEND_API_KEY="re_xxxxxxxx"
# Sandbox sender that works with zero setup, but can only deliver to the email
# on your own Resend account until you verify a domain. Once you verify a
# domain in the Resend dashboard, change this to an address on that domain.
EMAIL_FROM="Weekly Fantasy <onboarding@resend.dev>"

# Africa's Talking (SMS phone verification for Ethiopian numbers)
# Get credentials at africastalking.com. Use username "sandbox" + your sandbox
# API key for free testing (delivers to numbers you register in the sandbox
# simulator, not real phones). For real delivery to Ethio Telecom numbers,
# you need a registered Alphanumeric Sender ID - see Africa's Talking's
# Ethiopia docs, as this is a compliance requirement, not just a Twilio thing.

# Cron (gameweek deadline processing) - generate with: openssl rand -base64 32
# Vercel automatically sends this as a Bearer token to your cron endpoint when
# the env var is named exactly CRON_SECRET. For local testing, call the
# endpoint yourself with the same value - see the README.
CRON_SECRET="replace-me"
